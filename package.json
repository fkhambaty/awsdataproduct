{
  "name": "funberrykids",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@funberry/web",
    "dev:mobile": "turbo dev --filter=@funberry/mobile",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "typecheck": "turbo typecheck",
    "typecheck:tools": "tsc --noEmit -p scripts/tsconfig.json",
    "test:lesson-gen": "tsx --test packages/game-engine/src/lesson/rulesEngine.test.ts packages/game-engine/src/games/evs/computers.test.ts",
    "eval:packs": "tsx scripts/eval-learning-packs.ts"
  },
  "devDependencies": {
    "tesseract.js": "^5.1.1",
    "tsx": "^4.23.12",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  },
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=20"
  }
}
